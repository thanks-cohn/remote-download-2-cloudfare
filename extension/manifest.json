{
  "manifest_version": 3,
  "name": "REDOWN",
  "version": "0.5.7",
  "description": "Send remote files straight to Cloudflare R2 or GitHub without downloading them through your computer.",
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "identity",
    "downloads"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://api.cloudflare.com/*",
    "https://dash.cloudflare.com/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "REDOWN",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "128": "icon.svg"
  },
  "key": ""
}
