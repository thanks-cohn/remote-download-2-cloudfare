{
  "manifest_version": 3,
  "name": "Remote Asset Ingest",
  "version": "0.2.0",
  "description": "Send remote assets directly to Cloudflare R2 or GitHub without downloading them through your computer.",
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Remote Asset Ingest",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "key": ""
}
