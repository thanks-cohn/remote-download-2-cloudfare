{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redown.dev/debug/0.1/common.schema.json",
  "$defs": {
    "caseId": {
      "type": "string",
      "pattern": "^DBG-[0-9]{3,}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "sourceType",
        "collector",
        "sourceReference",
        "reviewStatus"
      ],
      "properties": {
        "sourceType": {
          "enum": [
            "explicit",
            "inferred",
            "imported",
            "historical",
            "agent-proposed"
          ]
        },
        "collector": {
          "type": "string",
          "minLength": 1
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1
        },
        "reviewStatus": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "reference": {
      "type": "object",
      "required": [
        "path",
        "symbol",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "role": {
          "enum": [
            "source",
            "test",
            "document"
          ]
        }
      },
      "additionalProperties": true
    },
    "proof": {
      "type": "object",
      "required": [
        "method",
        "scope",
        "environment",
        "result"
      ],
      "properties": {
        "method": {
          "enum": [
            "static-analysis",
            "automated-test",
            "manual-browser"
          ]
        },
        "scope": {
          "enum": [
            "source",
            "automated",
            "browser"
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
